# ══════════════════════════════════════════════════════════════════════════════
# GymFlow — root app (owner console + member PWA)
#
#   cp .env.example .env.local      then fill in the values
#
# Only the block marked REQUIRED is needed to start the app. Every other block
# switches on one feature, and the app keeps working without it.
#
# Never commit .env.local. Every value below is a placeholder, not a real key.
# The other projects have their own files:
#   gymflow-admin/.env.example    gymflow-mobile/.env.example    landing-page-1/.env.example
# ══════════════════════════════════════════════════════════════════════════════


# ── REQUIRED: Supabase ───────────────────────────────────────────────────────
# Supabase dashboard → Project Settings → API.
#
# These are deliberately NOT prefixed NEXT_PUBLIC_, so Next.js never inlines them
# into the browser bundle: the browser never talks to Supabase directly. They are
# read through lib/supabase/env.ts. Do not add NEXT_PUBLIC_SUPABASE_* variables.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security. Treat it like a root
# password: server only, never in client code, never in a log.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key


# ── REQUIRED: App URLs ───────────────────────────────────────────────────────
# NEXT_PUBLIC_APP_URL — the app's own origin. Used to build links in auth emails
#   and the QStash callback URL.
# NEXT_PUBLIC_API_URL — base URL the browser uses for API calls. Keep it equal to
#   the app origin so requests stay same-origin (no CORS preflight).
#
#   Local development:  http://localhost:3004
#   Production:         https://app.your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3004
NEXT_PUBLIC_API_URL=http://localhost:3004


# ── REQUIRED IN PRODUCTION: secrets you generate yourself ────────────────────
# Generate each one separately with:  openssl rand -hex 32
#
# CRON_SECRET — authenticates the cron routes (/api/cron/*) and the manual queue
#   drain. On Vercel it must equal the CRON_SECRET project environment variable.
CRON_SECRET=generate_with_openssl_rand_hex_32

# ADMIN_PASSWORD — protects the subscription-approval API routes in this app.
#   The routes fail closed (reject everything) when it is unset.
# ADMIN_EMAIL — the one account allowed into the /owner/admin pages.
ADMIN_PASSWORD=generate_with_openssl_rand_hex_32
ADMIN_EMAIL=you@example.com


# ── Optional: free-trial length ──────────────────────────────────────────────
# Days a new gym can use the app before the paywall applies. Default 14.
TRIAL_DURATION_DAYS=14


# ── Optional: Upstash Redis (cache + rate limiting) ──────────────────────────
# console.upstash.com → Redis → REST API.
# Without these the app still runs: caching is skipped and rate limiting is off.
# Set them in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ── Optional: Resend (transactional email) ───────────────────────────────────
# Sends the signup / set-password, member confirmation and account-deletion code
# emails through Resend published templates (the HTML sources are in emails/).
# Key: https://resend.com/api-keys
#
#   RESEND_FROM — a sender on a domain you have verified in Resend.
#
# The logo of each email is not configured here: every published template carries
# its own logo_url default. See docs/SELF_HOSTING.md for publishing the templates.
#
# Without these, those emails are not sent (the rest of the app is unaffected).
RESEND_API_KEY=
RESEND_FROM=Your App <noreply@your-domain.com>


# ── Optional: WhatsApp Cloud API (Meta) ──────────────────────────────────────
# Needed for every WhatsApp message. Requires a Meta Business account, a
# registered phone number, and approved message templates whose names and
# parameters match the code. See docs/WHATSAPP_README.md.
#
#   WHATSAPP_VERIFY_TOKEN  — any string you choose (32+ chars); you enter the
#                            same value when registering the webhook with Meta.
#   WHATSAPP_APP_SECRET    — Meta app dashboard → App settings → Basic.
#   WHATSAPP_BASE_URL      — where Graph API calls are sent. Use Meta directly
#                            (https://graph.facebook.com) unless you run the
#                            reverse proxy described below.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BASE_URL=https://graph.facebook.com

# The hosted GymFlow sends Graph calls through its own reverse proxy
# (/api/graph/[...path], served on a dedicated hostname). You only need these two
# if you set up the same thing; then point WHATSAPP_BASE_URL at
# https://<your-graph-host>/api/graph instead.
#
#   GRAPH_API_BASE_URL — the proxy's upstream.
#   GRAPH_PROXY_SECRET — optional shared secret. The proxy holds no Meta
#     credential (it forwards the caller's Authorization header) and is already
#     limited by an endpoint allowlist, a per-IP rate limit and rejection of
#     browser requests. Setting this makes it accept only our own server. It is
#     opt-in and atomic: the proxy checks it, and services/whatsapp/graph.ts
#     sends it, only when it is set. Leave blank to keep the layer off.
#     Generate with: openssl rand -hex 32
GRAPH_API_BASE_URL=https://graph.facebook.com
GRAPH_PROXY_SECRET=


# ── Optional: Upstash QStash (throttled WhatsApp send queue) ─────────────────
# Bulk sends (after an import, and the daily cron) are queued and drained at
# 5 messages every 5 minutes. console.upstash.com → QStash.
#
# The drain endpoint is ${NEXT_PUBLIC_APP_URL}/api/whatsapp/queue/drain and must
# be reachable from the internet. QStash cannot call localhost, so in development
# trigger the drain by hand:
#   curl -X POST -H "x-cron-secret: $CRON_SECRET" http://localhost:3004/api/whatsapp/queue/drain
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=


# ── Optional: Google Maps Platform (address autocomplete in onboarding) ──────
# This key is public by design (NEXT_PUBLIC_ → shipped to the browser), so
# restrict it to your domains in the Google Cloud console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=


# ── Optional: Sentry (error and performance monitoring) ──────────────────────
# Project Settings → Client Keys (DSN). Blank disables reporting.
NEXT_PUBLIC_SENTRY_DSN=


# ── Optional: logging ────────────────────────────────────────────────────────
# debug | info | warn | error. Default: info. See lib/logger.ts.
# LOG_LEVEL=info


# ── Optional: dev-only AI script ─────────────────────────────────────────────
# Only read by scripts/test-ai-raw.ts. The app itself does not use it; the
# support-inbox AI drafts are configured in gymflow-admin/.env.example.
# GROQ_API_KEY=
