NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
GROQ_API_KEY=your_gemini_api_key
NEXT_PUBLIC_APP_URL=your_vercel_deployment_link
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_from_project_settings

# WhatsApp Cloud API Configuration
WHATSAPP_VERIFY_TOKEN=your_whatsapp_webhook_verify_token_min_32_chars
WHATSAPP_APP_SECRET=your_whatsapp_app_secret_from_meta_dashboard
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_business_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BASE_URL=https://graph.gymflow.sbs/api/graph

# Transparent reverse proxy — upstream destination (read by /api/graph/[...path])
GRAPH_API_BASE_URL=https://graph.facebook.com

# Cron job secret — must match the value set in Vercel environment variables
# Generate with: openssl rand -hex 32
CRON_SECRET=your_cron_secret_min_32_chars

# ── WhatsApp throttled send queue (QStash) ──────────────────────────────────
# Bulk automated sends (post-import batch + daily cron) are enqueued and drained
# at 5 messages / 5 minutes via Upstash QStash. Get these from the Upstash
# console (QStash tab). The drain endpoint is ${NEXT_PUBLIC_APP_URL}/api/whatsapp/queue/drain
# and must be publicly reachable (QStash cannot call localhost — trigger the
# drain manually in dev: curl -X POST -H "x-cron-secret: $CRON_SECRET" <url>).
QSTASH_TOKEN=your_qstash_token
QSTASH_CURRENT_SIGNING_KEY=your_qstash_current_signing_key
QSTASH_NEXT_SIGNING_KEY=your_qstash_next_signing_key

# ── Subscription / Trial ──────────────────────────────────────────────────────
# Number of days for the free trial (default: 14)
TRIAL_DURATION_DAYS=14
