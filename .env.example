# ── Supabase — PRIVATE (server runtime only) ─────────────────────────────────
# Not prefixed NEXT_PUBLIC_, so Next.js never inlines these into the browser
# bundle. This is what keeps the Supabase project hostname out of client JS.
# Read via lib/supabase/env.ts.
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Base URL the browser uses for API calls. Leave equal to the app origin to keep
# requests same-origin (no CORS preflight). Set to https://api.gymflow.sbs only
# if the API is served from a separate hostname.
NEXT_PUBLIC_API_URL=https://app.gymflow.sbs
GROQ_API_KEY=your_gemini_api_key
# App base URL — used for auth email redirects (emailRedirectTo).
# Development: http://localhost:3000
# Production:  https://app.gymflow.sbs
NEXT_PUBLIC_APP_URL=https://app.gymflow.sbs
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
UPSTASH_REDIS_REST_URL=your_upstash_redis_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_from_project_settings

# WhatsApp Cloud API Configuration
WHATSAPP_VERIFY_TOKEN=your_whatsapp_webhook_verify_token_min_32_chars
WHATSAPP_APP_SECRET=your_whatsapp_app_secret_from_meta_dashboard
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_business_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_API_VERSION=v21.0
WHATSAPP_BASE_URL=https://graph.gymflow.sbs/api/graph

# Transparent reverse proxy — upstream destination (read by /api/graph/[...path])
GRAPH_API_BASE_URL=https://graph.facebook.com

# OPTIONAL hardening for the /api/graph reverse proxy.
# The proxy holds no Meta credential (it forwards the caller's Authorization
# header), and is already protected by an endpoint allowlist, a 120/min per-IP
# rate limit, and rejection of browser-originated requests. Setting this adds a
# shared secret so only our own server can relay through it.
#
# Enforcement is opt-in and atomic: the proxy requires the header only when this
# is set, and services/whatsapp/graph.ts attaches it only when this is set. Both
# run in the same deployment and read this same variable, so turning it on cannot
# leave WhatsApp sending broken. Leave blank to keep the layer disabled.
# Generate with: openssl rand -hex 32
GRAPH_PROXY_SECRET=

# Cron job secret — must match the value set in Vercel environment variables
# Generate with: openssl rand -hex 32
CRON_SECRET=your_cron_secret_min_32_chars

# ── WhatsApp throttled send queue (QStash) ──────────────────────────────────
# Bulk automated sends (post-import batch + daily cron) are enqueued and drained
# at 5 messages / 5 minutes via Upstash QStash. Get these from the Upstash
# console (QStash tab). The drain endpoint is ${NEXT_PUBLIC_APP_URL}/api/whatsapp/queue/drain
# and must be publicly reachable (QStash cannot call localhost — trigger the
# drain manually in dev: curl -X POST -H "x-cron-secret: $CRON_SECRET" <url>).
QSTASH_TOKEN=your_qstash_token
QSTASH_CURRENT_SIGNING_KEY=your_qstash_current_signing_key
QSTASH_NEXT_SIGNING_KEY=your_qstash_next_signing_key

# ── Subscription / Trial ──────────────────────────────────────────────────────
# Number of days for the free trial (default: 14)
TRIAL_DURATION_DAYS=14

# ── Admin Security ────────────────────────────────────────────────────────────
# Password for the /admin subscription approval routes in the main app.
# Generate with: openssl rand -hex 32
ADMIN_PASSWORD=your_admin_password_min_32_chars

# Email of the platform super-admin (used in /admin layout gate)
ADMIN_EMAIL=your_admin_email@example.com

# ⚠️  IMPORTANT: ADMIN_PANEL_SECRET must be DIFFERENT from ADMIN_PASSWORD.
# This secret protects the separate gymflow-admin panel (JWT signing for admin sessions).
# If one is compromised, the other system should remain secure.
# Generate a SEPARATE value with: openssl rand -hex 32
ADMIN_PANEL_SECRET=your_admin_panel_secret_MUST_BE_DIFFERENT_FROM_ADMIN_PASSWORD
