# GymFlow Admin Panel — Environment Variables
# Copy this file to .env.local and fill in the values

# ─── Supabase (use the SERVICE ROLE key — never expose this client-side) ───
NEXT_PUBLIC_SUPABASE_URL=PASTE_YOUR_SUPABASE_URL_HERE
SUPABASE_SERVICE_ROLE_KEY=PASTE_YOUR_SERVICE_ROLE_KEY_HERE

# ─── Sentry (for reading logs and errors via REST API) ───
SENTRY_AUTH_TOKEN=PASTE_YOUR_SENTRY_AUTH_TOKEN_HERE
SENTRY_ORG=PASTE_YOUR_SENTRY_ORG_SLUG_HERE
SENTRY_PROJECT=PASTE_YOUR_SENTRY_PROJECT_SLUG_HERE

# ─── Admin Panel Security ───
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PANEL_SECRET=PASTE_A_STRONG_RANDOM_SECRET_HERE

# ─── App URL (for cookie domain etc) ───
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
