# GymFlow Admin Panel — Environment Variables
#
#   cp .env.example .env.local      then fill in the values
#
# REQUIRED to start: the Supabase block and ADMIN_PANEL_SECRET.
# Everything else switches on one feature; see README.md → Environment.
# Every value below is a placeholder, not a real key. Never commit .env.local.

# ─── Supabase (use the SERVICE ROLE key — never expose this client-side) ───
# Use the SAME Supabase project as the root app.
NEXT_PUBLIC_SUPABASE_URL=PASTE_YOUR_SUPABASE_URL_HERE
# Optional: a server-only URL. When set, lib/supabase-admin.ts prefers it over the public one.
# SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=PASTE_YOUR_SERVICE_ROLE_KEY_HERE

# Anon key — used ONLY for Supabase Realtime subscriptions (broadcast channels).
# Safe to expose client-side: RLS still applies and the admin panel uses it
# exclusively to RECEIVE live events, never for data mutations.
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_YOUR_SUPABASE_ANON_KEY_HERE

# ─── Sentry (optional; the Logs page reads errors through Sentry's REST API) ───
SENTRY_AUTH_TOKEN=PASTE_YOUR_SENTRY_AUTH_TOKEN_HERE
SENTRY_ORG=PASTE_YOUR_SENTRY_ORG_SLUG_HERE
SENTRY_PROJECT=PASTE_YOUR_SENTRY_PROJECT_SLUG_HERE

# ─── Admin Panel Security (REQUIRED) ───
# This one value is the login password for the panel AND the Bearer token the mobile app
# sends. It must be different from ADMIN_PASSWORD in the root app.
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PANEL_SECRET=PASTE_A_STRONG_RANDOM_SECRET_HERE

# ─── App URL (for cookie domain etc) ───
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# ─── Redis (optional: login rate limiting and AI token budgets) ───
# Without it, login is not rate limited and AI budgets are tracked in memory per process.
UPSTASH_REDIS_REST_URL=PASTE_YOUR_UPSTASH_REST_URL_HERE
UPSTASH_REDIS_REST_TOKEN=PASTE_YOUR_UPSTASH_REST_TOKEN_HERE

# ─── Support inbox: Resend (optional; receive + reply at your support address) ───
# RESEND_API_KEY needs permission to send AND to read received email.
# RESEND_WEBHOOK_SECRET is the signing secret of the webhook for
#   https://<your-admin-host>/api/email/inbound  (event: email.received)
RESEND_API_KEY=PASTE_YOUR_RESEND_API_KEY_HERE
RESEND_WEBHOOK_SECRET=PASTE_YOUR_RESEND_WEBHOOK_SIGNING_SECRET_HERE
SUPPORT_EMAIL_ADDRESS=support@your-domain.com
SUPPORT_EMAIL_FROM_NAME=Your Support Team
# Optional: logo shown at the top of reply emails. Must be a PNG or JPG URL (email clients
# do not render SVG). Defaults to the GymFlow logo in lib/email-html.ts.
# SUPPORT_EMAIL_LOGO_URL=https://your-domain.com/logo.png

# ─── AI reply drafts (optional; Groq, or any OpenAI-compatible API) ───
# Drafts only: a person sends every reply. The model answers only from
# lib/support-knowledge.ts, which you must rewrite for your own product.
# Free key: console.groq.com -> API Keys. Leave AI_API_KEY unset to turn drafting off.
# AI_MODELS is tried in order; each model has its own free limits (30 req/min, 8K tokens/min,
# 1K req/day, 200K tokens/day). Confirm the exact ids in the Groq console.
AI_API_KEY=PASTE_YOUR_GROQ_API_KEY_HERE
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# Budgets sit under Groq's per-model caps (8K tokens/min, 200K tokens/day) as a safety margin.
AI_TPM_BUDGET=6000
AI_TPD_BUDGET=160000
AI_DAILY_LIMIT=50

# ─── Firebase Admin (optional; server-side FCM push sender for the mobile app) ───
# From the service-account JSON (Firebase Console → Project Settings → Service Accounts).
# Paste FIREBASE_PRIVATE_KEY as ONE line, wrapped in double quotes, keeping the literal \n escapes.
FIREBASE_PROJECT_ID=PASTE_YOUR_FIREBASE_PROJECT_ID_HERE
FIREBASE_CLIENT_EMAIL=PASTE_YOUR_FIREBASE_CLIENT_EMAIL_HERE
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_KEY_WITH_\n_ESCAPES\n-----END PRIVATE KEY-----\n"

# ─── Cron secret (authorizes /api/push/dispatch and other cron routes) ───
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=PASTE_A_STRONG_RANDOM_SECRET_HERE

# ═══════════════════════════════════════════════════════════════════
# SECURITY NOTICE:
# - NEVER commit .env.local to version control
# - Rotate all secrets regularly (every 90 days minimum)
# - Use different secrets for dev/staging/production
# - Limit access to production secrets (need-to-know basis only)
# ═══════════════════════════════════════════════════════════════════
