{
  // LEGACY, DO NOT DEPLOY: replaced by ../../worker
  // Front door for biometric devices. Deploy from this folder: npx wrangler deploy
  // Then set the private receiver address once (never commit it): npx wrangler secret put ORIGIN_URL
  "name": "gymflow-bio-legacy-proxy",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  // Keep-alive ping for the free instabox box (idle pause after 30 min). Fires at :00, :25 and :50.
  "triggers": { "crons": ["*/25 * * * *"] },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}

