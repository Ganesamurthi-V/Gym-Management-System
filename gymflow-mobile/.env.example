# GymFlow Admin mobile app — environment variables
#
#   cp .env.example .env.local
#
# react-native-dotenv reads .env.local (see babel.config.js) and exposes these as
# imports from '@env'. They are compiled INTO the app, so anyone with the APK can
# read them: put only public values here, never a service-role key or a password.
#
# After changing this file, restart Metro with a clean cache:
#   npx react-native start --reset-cache

# Where the gymflow-admin backend runs, for DEVELOPMENT builds only.
# Use your computer's LAN address, not localhost: on a phone or emulator,
# "localhost" is the device itself.
# Release builds ignore this and use the production host that is hard-coded in
# lib/api/client.ts (defaultBaseUrl). Change that constant for your own deployment.
ADMIN_API_BASE=http://192.168.1.10:3001

# Supabase project URL and anon (public) key. Used only to receive payload-free
# realtime "something changed" hints; all data is fetched through the admin API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
